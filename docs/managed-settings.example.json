{
  "$comment": "Managed (organisation-owned) Claude Code settings for unattended and regulated use. Deployed by the platform team via MDM or the admin console, NOT committed to a product repo as .claude/settings.json — engineers cannot edit or override anything here. A starting point to tailor, not a recommendation to copy: every deny trades against capability. See docs/PORTING.md § Managed settings and the AI-Native SDLC Playbook pp. 42-43.",

  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(./secrets/**)",
      "WebFetch",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "allow": [
      "Bash(git *)",
      "Bash(npm test*)",
      "Bash(npm lint*)",
      "Bash(npm typecheck*)",
      "Bash(npm build*)",
      "Bash(rg *)",
      "Bash(node *)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedPermissionRulesOnly": true,

  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "github.com",
        "api.github.com",
        "registry.npmjs.org"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws/credentials", "mode": "deny" }
      ],
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" }
      ]
    }
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/production-gate.sh" }
        ]
      }
    ]
  },
  "allowManagedHooksOnly": true,

  "disableSideloadFlags": true,
  "allowManagedMcpServersOnly": true,
  "strictKnownMarketplaces": [
    { "source": "github", "repo": "<your-org>/approved-plugins" }
  ],
  "requiredMinimumVersion": "2.1.193"
}
